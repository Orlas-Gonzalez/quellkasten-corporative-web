---
import Container from '../ui/Container.astro';

const navigationItems = [
	{ label: 'Inicio', href: '#inicio', translationKey: 'navHome' },
	{ label: 'Servicios', href: '#servicios', translationKey: 'navServices' },
	{ label: 'Soluciones', href: '#soluciones', translationKey: 'navSolutions' },
	{ label: 'Proyectos', href: '#proyectos', translationKey: 'navProjects' },
	{ label: 'Nosotros', href: '#nosotros', translationKey: 'navAbout' },
	{ label: 'Contacto', href: '#contacto', translationKey: 'navContact' },
];
---

<header class="sticky top-0 z-50 pt-4 sm:pt-5">
	<Container>
		<nav
			aria-label="Navegación principal"
			data-i18n-aria="navLabel"
			data-navbar
			class="overflow-hidden rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] shadow-[0_18px_55px_var(--color-shadow)] backdrop-blur-xl"
		>
			<div class="flex h-16 items-center gap-2 px-3 sm:gap-4 sm:px-5">
				<a
					href="/"
					aria-label="Quellkasten, página de inicio"
					data-i18n-aria="brandHomeLabel"
					class="group flex shrink-0 items-center gap-2 rounded-lg outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] sm:gap-2.5"
				>
					<img
						src="/favicons/favicon.svg"
						alt=""
						width="40"
						height="40"
						class="size-9 object-contain transition-transform duration-300 group-hover:scale-105 sm:size-10"
					/>
					<span class="flex flex-col">
						<span class="text-sm font-semibold leading-tight tracking-[-0.02em] text-[var(--color-text)] sm:text-base">
							Quellkasten
						</span>
						<span
							data-i18n="brandTagline"
							class="mt-0.5 text-[9px] font-medium uppercase leading-none tracking-[0.12em] text-[var(--color-text-muted)] sm:text-[10px]"
						>
							Desarrollo de software
						</span>
					</span>
				</a>

				<div class="mx-auto hidden items-center gap-1 lg:flex">
					{
						navigationItems.map(({ label, href, translationKey }, index) => (
							<a
								href={href}
								data-i18n={translationKey}
								aria-current={index === 0 ? 'page' : undefined}
								class:list={[
									'rounded-lg px-3 py-2 text-sm font-medium outline-none transition-colors focus-visible:ring-2 focus-visible:ring-[var(--color-accent)]',
									index === 0
										? 'bg-[var(--color-accent-soft)] text-[var(--color-accent)]'
										: 'text-[var(--color-text-muted)] hover:bg-[var(--color-accent-hover)] hover:text-[var(--color-text)]',
								]}
							>
								{label}
							</a>
						))
					}
				</div>

				<div class="ml-auto flex shrink-0 items-center gap-1.5 sm:gap-2">
					<button
						type="button"
						aria-label="Cambiar tema de color"
						title="Cambiar a modo oscuro"
						aria-pressed="false"
						data-theme-toggle
						class="grid size-9 cursor-pointer place-items-center rounded-xl border border-[var(--color-border)] bg-[var(--color-surface-strong)] text-[var(--color-text-muted)] outline-none transition hover:border-[var(--color-border-strong)] hover:bg-[var(--color-accent-hover)] hover:text-[var(--color-accent)] focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] sm:size-10"
					>
						<svg
							aria-hidden="true"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.8"
							class="size-[18px]"
							data-theme-icon="moon"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								d="M21 12.8A8.5 8.5 0 1 1 11.2 3 6.7 6.7 0 0 0 21 12.8Z"
							></path>
						</svg>
						<svg
							aria-hidden="true"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.8"
							class="size-[18px]"
							data-theme-icon="sun"
							hidden
						>
							<circle cx="12" cy="12" r="3.5"></circle>
							<path
								stroke-linecap="round"
								d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"
							></path>
						</svg>
					</button>

					<button
						type="button"
						aria-label="Cambiar idioma"
						title="Cambiar idioma a inglés"
						data-language-toggle
						class="grid size-9 cursor-pointer place-items-center rounded-xl border border-[var(--color-border)] bg-[var(--color-surface-strong)] text-xs font-semibold text-[var(--color-text-muted)] outline-none transition hover:border-[var(--color-border-strong)] hover:bg-[var(--color-accent-hover)] hover:text-[var(--color-text)] focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] sm:flex sm:h-10 sm:w-auto sm:gap-2 sm:px-3"
					>
						<svg
							aria-hidden="true"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.8"
							class="hidden size-[17px] text-[var(--color-accent)] sm:block"
						>
							<circle cx="12" cy="12" r="9"></circle>
							<path stroke-linecap="round" d="M3.5 9h17M3.5 15h17M12 3c2 2.3 3 5.3 3 9s-1 6.7-3 9c-2-2.3-3-5.3-3-9s1-6.7 3-9Z"></path>
						</svg>
						<span
							data-language-current
							class="rounded-md bg-[var(--color-accent-soft)] px-1.5 py-0.5 font-bold text-[var(--color-accent)]"
						>
							ES
						</span>
						<span class="hidden text-[var(--color-border)] sm:inline" aria-hidden="true">/</span>
						<span data-language-next class="hidden text-[var(--color-text-soft)] sm:inline">EN</span>
					</button>

					<button
						type="button"
						aria-label="Abrir menú de navegación"
						aria-controls="mobile-navigation"
						aria-expanded="false"
						data-menu-toggle
						class="group grid size-9 cursor-pointer place-items-center rounded-xl border border-[var(--color-border)] bg-[var(--color-surface-strong)] text-[var(--color-text-muted)] outline-none transition hover:border-[var(--color-border-strong)] hover:bg-[var(--color-accent-hover)] hover:text-[var(--color-text)] focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] lg:hidden"
					>
						<svg
							aria-hidden="true"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.8"
							class="size-[18px] group-aria-expanded:hidden"
						>
							<path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
						</svg>
						<svg
							aria-hidden="true"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.8"
							class="hidden size-[18px] group-aria-expanded:block"
						>
							<path stroke-linecap="round" d="m6 6 12 12M18 6 6 18"></path>
						</svg>
					</button>
				</div>
			</div>

			<div
				id="mobile-navigation"
				data-mobile-menu
				data-state="closed"
				aria-hidden="true"
				inert
				class="grid grid-rows-[0fr] border-t border-transparent opacity-0 transition-[grid-template-rows,opacity,border-color] duration-200 ease-out data-[state=open]:grid-rows-[1fr] data-[state=open]:border-[var(--color-border)] data-[state=open]:opacity-100 lg:hidden"
			>
				<div class="overflow-hidden">
					<div class="grid justify-items-center gap-1 p-2">
						{
							navigationItems.map(({ label, href, translationKey }, index) => (
								<a
									href={href}
									data-i18n={translationKey}
									aria-current={index === 0 ? 'page' : undefined}
									class:list={[
										'w-full max-w-sm rounded-xl px-4 py-3 text-center text-sm font-medium outline-none transition-colors focus-visible:ring-2 focus-visible:ring-[var(--color-accent)]',
										index === 0
											? 'bg-[var(--color-accent-soft)] text-[var(--color-accent)]'
											: 'text-[var(--color-text-muted)] hover:bg-[var(--color-accent-hover)] hover:text-[var(--color-text)]',
									]}
								>
									{label}
								</a>
							))
						}
					</div>
				</div>
			</div>
		</nav>
	</Container>
</header>

<script>
	import {
		defaultLanguage,
		translations,
		type Language,
	} from '../../i18n/translations';

	type Theme = 'light' | 'dark';
	type TranslationKey = keyof typeof translations.es;

	const navbar = document.querySelector<HTMLElement>('[data-navbar]');

	if (navbar) {
		const toggle = navbar.querySelector<HTMLButtonElement>('[data-menu-toggle]');
		const menu = navbar.querySelector<HTMLElement>('[data-mobile-menu]');
		const themeToggle = navbar.querySelector<HTMLButtonElement>('[data-theme-toggle]');
		const languageToggle = navbar.querySelector<HTMLButtonElement>('[data-language-toggle]');
		const moonIcon = navbar.querySelector<SVGElement>('[data-theme-icon="moon"]');
		const sunIcon = navbar.querySelector<SVGElement>('[data-theme-icon="sun"]');
		const languageCurrent = navbar.querySelector<HTMLElement>('[data-language-current]');
		const languageNext = navbar.querySelector<HTMLElement>('[data-language-next]');

		const getInitialLanguage = (): Language => {
			try {
				const storedLanguage = localStorage.getItem('language');
				if (storedLanguage === 'es' || storedLanguage === 'en') {
					return storedLanguage;
				}
			} catch {
				// Use the document language when storage is unavailable.
			}

			return document.documentElement.lang === 'en' ? 'en' : defaultLanguage;
		};

		const getCurrentTheme = (): Theme =>
			document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';

		let currentLanguage = getInitialLanguage();

		const isMenuOpen = () => toggle?.getAttribute('aria-expanded') === 'true';

		const updateMenuLabel = () => {
			if (!toggle) return;
			const copy = translations[currentLanguage];
			const label = isMenuOpen() ? copy.menuClose : copy.menuOpen;
			toggle.setAttribute('aria-label', label);
			toggle.title = label;
		};

		const updateThemeControl = () => {
			if (!themeToggle) return;
			const isDark = getCurrentTheme() === 'dark';
			const copy = translations[currentLanguage];
			const label = isDark ? copy.themeToLight : copy.themeToDark;

			themeToggle.setAttribute('aria-label', label);
			themeToggle.setAttribute('aria-pressed', String(isDark));
			themeToggle.title = label;

			moonIcon?.toggleAttribute('hidden', isDark);
			sunIcon?.toggleAttribute('hidden', !isDark);
		};

		const setTheme = (theme: Theme, persist = true) => {
			document.documentElement.dataset.theme = theme;
			document.documentElement.style.colorScheme = theme;

			if (persist) {
				try {
					localStorage.setItem('theme', theme);
				} catch {
					// The theme still applies for the current page.
				}
			}

			updateThemeControl();
		};

		const applyLanguage = (language: Language, persist = true) => {
			currentLanguage = language;
			const copy = translations[language];

			document.documentElement.lang = language;
			document.title = copy.documentTitle;

			const description = document.querySelector<HTMLMetaElement>(
				'meta[name="description"]',
			);
			if (description) description.content = copy.documentDescription;

			navbar.querySelectorAll<HTMLElement>('[data-i18n]').forEach((element) => {
				const key = element.dataset.i18n as TranslationKey | undefined;
				if (key) element.textContent = copy[key];
			});

			navbar.querySelectorAll<HTMLElement>('[data-i18n-aria]').forEach((element) => {
				const key = element.dataset.i18nAria as TranslationKey | undefined;
				if (key) element.setAttribute('aria-label', copy[key]);
			});

			if (languageCurrent) languageCurrent.textContent = language.toUpperCase();
			if (languageNext) {
				languageNext.textContent = language === 'es' ? 'EN' : 'ES';
			}

			if (languageToggle) {
				const label =
					language === 'es'
						? copy.languageToEnglish
						: copy.languageToSpanish;
				languageToggle.setAttribute('aria-label', label);
				languageToggle.title = label;
			}

			if (persist) {
				try {
					localStorage.setItem('language', language);
				} catch {
					// The language still applies for the current page.
				}
			}

			updateThemeControl();
			updateMenuLabel();
		};

		if (toggle && menu) {
			const setMenuState = (isOpen: boolean) => {
				toggle.setAttribute('aria-expanded', String(isOpen));
				menu.dataset.state = isOpen ? 'open' : 'closed';
				menu.setAttribute('aria-hidden', String(!isOpen));
				menu.inert = !isOpen;
				updateMenuLabel();
			};

			toggle.addEventListener('click', () => {
				setMenuState(!isMenuOpen());
			});

			menu.querySelectorAll('a').forEach((link) => {
				link.addEventListener('click', () => setMenuState(false));
			});

			document.addEventListener('keydown', (event) => {
				if (event.key === 'Escape' && isMenuOpen()) {
					setMenuState(false);
					toggle.focus();
				}
			});

			document.addEventListener('click', (event) => {
				if (
					isMenuOpen()
					&& event.target instanceof Node
					&& !navbar.contains(event.target)
				) {
					setMenuState(false);
				}
			});

			const desktopBreakpoint = window.matchMedia('(min-width: 64rem)');
			desktopBreakpoint.addEventListener('change', ({ matches }) => {
				if (matches) setMenuState(false);
			});
		}

		themeToggle?.addEventListener('click', () => {
			setTheme(getCurrentTheme() === 'dark' ? 'light' : 'dark');
		});

		languageToggle?.addEventListener('click', () => {
			applyLanguage(currentLanguage === 'es' ? 'en' : 'es');
		});

		setTheme(getCurrentTheme(), false);
		applyLanguage(currentLanguage, false);
	}
</script>
