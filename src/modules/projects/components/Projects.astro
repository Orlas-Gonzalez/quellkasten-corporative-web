---
import Container from '../../../components/ui/Container.astro';

type Project = {
	title: string;
	category: string;
	description: string;
	challenge: string;
	technologies: string[];
	image?: string;
	href?: string;
};

// Los casos reales se agregarán aquí cuando estén listos para publicarse.
const projects: Project[] = [];
---

<section
	id="proyectos"
	aria-labelledby="projects-title"
	class="relative scroll-mt-28 overflow-hidden border-t border-[var(--color-border)] py-20 sm:py-24 lg:py-32"
>
	<div
		aria-hidden="true"
		class="absolute left-1/2 top-1/2 -z-10 size-[34rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[var(--color-accent)] opacity-[0.05] blur-3xl"
	></div>

	<Container>
		<header class="mx-auto max-w-3xl text-center">
			<div class="flex items-center justify-center gap-3">
				<span class="h-px w-8 bg-[var(--color-accent)]" aria-hidden="true"></span>
				<p
					data-i18n="projectsLabel"
					class="text-xs font-semibold uppercase tracking-[0.16em] text-[var(--color-accent)]"
				>
					Proyectos
				</p>
				<span class="h-px w-8 bg-[var(--color-accent)]" aria-hidden="true"></span>
			</div>

			<h2
				id="projects-title"
				data-i18n="projectsTitle"
				class="mt-5 text-3xl font-bold leading-tight tracking-[-0.035em] text-[var(--color-text)] sm:text-4xl lg:text-5xl"
			>
				Soluciones construidas para generar resultados reales.
			</h2>

			<p
				data-i18n="projectsDescription"
				class="mx-auto mt-5 max-w-2xl text-base leading-7 text-[var(--color-text-muted)]"
			>
				Este espacio reunirá proyectos que muestran el reto de cada empresa, el camino que
				seguimos y el resultado alcanzado.
			</p>
		</header>

		{
			projects.length > 0 ? (
				<div class="mt-14 grid gap-6 lg:grid-cols-2">
					{projects.map((project) => (
						<article class="overflow-hidden rounded-3xl border border-[var(--color-border)] bg-[var(--color-surface)] shadow-[0_18px_45px_var(--color-shadow)]">
							{project.image && (
								<img
									src={project.image}
									alt=""
									class="aspect-[16/9] w-full object-cover"
									loading="lazy"
								/>
							)}
							<div class="p-6 sm:p-8">
								<p class="text-xs font-semibold uppercase tracking-[0.16em] text-[var(--color-accent)]">
									{project.category}
								</p>
								<h3 class="mt-3 text-2xl font-semibold text-[var(--color-text)]">{project.title}</h3>
								<p class="mt-4 text-base leading-7 text-[var(--color-text-muted)]">
									{project.description}
								</p>
								<div class="mt-5 flex flex-wrap gap-2">
									{project.technologies.map((technology) => (
										<span class="rounded-full border border-[var(--color-border)] px-3 py-1 text-xs text-[var(--color-text-soft)]">
											{technology}
										</span>
									))}
								</div>
							</div>
						</article>
					))}
				</div>
			) : (
				<div class="relative mx-auto mt-14 max-w-5xl overflow-hidden rounded-3xl border border-[var(--color-border)] bg-[var(--color-surface)] shadow-[0_24px_70px_var(--color-shadow)]">
					<div class="grid lg:grid-cols-[0.9fr_1.1fr]">
						<div class="relative min-h-72 overflow-hidden border-b border-[var(--color-border)] bg-[var(--color-page)] p-8 lg:min-h-[25rem] lg:border-b-0 lg:border-r">
							<div
								aria-hidden="true"
								class="absolute inset-0 opacity-40 [background-image:linear-gradient(var(--color-border)_1px,transparent_1px),linear-gradient(90deg,var(--color-border)_1px,transparent_1px)] [background-size:32px_32px]"
							></div>
							<div
								aria-hidden="true"
								class="absolute inset-x-8 top-1/2 h-px bg-gradient-to-r from-transparent via-[var(--color-accent)] to-transparent opacity-50"
							></div>
							<div
								aria-hidden="true"
								class="absolute inset-y-8 left-1/2 w-px bg-gradient-to-b from-transparent via-[var(--color-accent)] to-transparent opacity-50"
							></div>

							<div class="relative flex h-full items-center justify-center">
								<div class="relative grid size-40 place-items-center rounded-full border border-dashed border-[var(--color-border-strong)] sm:size-48">
									<div class="absolute inset-5 rounded-full border border-[var(--color-border)]"></div>
									<div class="grid size-20 place-items-center rounded-2xl border border-[var(--color-border-strong)] bg-[var(--color-accent-soft)] text-[var(--color-accent)] shadow-lg">
										<svg
											aria-hidden="true"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="1.5"
											class="size-9"
										>
											<path
												stroke-linecap="round"
												stroke-linejoin="round"
												d="M4 19.5V6.75A2.75 2.75 0 0 1 6.75 4h10.5A2.75 2.75 0 0 1 20 6.75V19.5M8 4V2.75M16 4V2.75M8 9h8M8 13h5M8 17h3"
											/>
										</svg>
									</div>
									<span class="absolute -right-1 top-9 size-3 rounded-full bg-[var(--color-accent)] shadow-[0_0_18px_var(--color-accent)]"></span>
									<span class="absolute bottom-5 left-3 size-2 rounded-full border border-[var(--color-accent)]"></span>
								</div>
							</div>
						</div>

						<div class="flex flex-col justify-center p-7 sm:p-10 lg:p-12">
							<p
								data-i18n="projectsEmptyLabel"
								class="text-xs font-semibold uppercase tracking-[0.16em] text-[var(--color-accent)]"
							>
								Próximamente
							</p>
							<h3
								data-i18n="projectsEmptyTitle"
								class="mt-4 text-2xl font-semibold leading-tight tracking-[-0.025em] text-[var(--color-text)] sm:text-3xl"
							>
								Estamos preparando nuestros primeros casos de estudio.
							</h3>
							<p
								data-i18n="projectsEmptyDescription"
								class="mt-5 text-base leading-7 text-[var(--color-text-muted)]"
							>
								Muy pronto podrás conocer cómo transformamos necesidades de negocio en soluciones
								digitales claras, funcionales y pensadas para crecer.
							</p>
							<div class="mt-6 flex items-start gap-3 border-t border-[var(--color-border)] pt-6">
								<svg
									aria-hidden="true"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="1.8"
									class="mt-0.5 size-5 shrink-0 text-[var(--color-accent)]"
								>
									<path stroke-linecap="round" stroke-linejoin="round" d="m5 12 4 4L19 6" />
								</svg>
								<p
									data-i18n="projectsEmptyDetail"
									class="text-sm leading-6 text-[var(--color-text-soft)]"
								>
									Cada caso incluirá el reto, nuestro proceso y los resultados obtenidos.
								</p>
							</div>
							<a
								href="#contacto"
								class="group mt-8 inline-flex w-fit items-center gap-2 rounded-xl bg-[var(--color-accent)] px-5 py-3 text-sm font-semibold text-[#0f172a] outline-none transition hover:bg-[var(--color-accent-strong)] focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-surface)]"
							>
								<span data-i18n="projectsCta">Cuéntanos sobre tu proyecto</span>
								<svg
									aria-hidden="true"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="1.8"
									class="size-4 transition-transform group-hover:translate-x-1"
								>
									<path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-5-5 5 5-5 5" />
								</svg>
							</a>
						</div>
					</div>
				</div>
			)
		}
	</Container>
</section>
